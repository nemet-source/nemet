# ============================================================
# Plantilla de Secrets de NEMET  →  copiar como secrets.toml
# ============================================================
# Local:    cp .streamlit/secrets.toml.ejemplo .streamlit/secrets.toml
# Nube:     Streamlit Community Cloud → App → Settings → Secrets
#
# `.streamlit/secrets.toml` está en .gitignore: NUNCA lo subas al repositorio.
# Este archivo de ejemplo no lleva credenciales reales, solo la estructura.

# ------------------------------------------------------------
# [auth]  Acceso al sistema (obligatorio para arrancar)
# ------------------------------------------------------------
[auth]
# Administrador inicial: se crea la PRIMERA vez que arranca la app.
# Después, la app ya no vuelve a leer la contraseña (así el secreto no es una
# puerta trasera permanente). Si el administrador la olvida, pon `admin_forzar = true`
# una sola vez para restablecerla y luego vuelve a dejarlo en false.
admin_usuario = "jefe"
admin_password = "CAMBIAME-por-una-contrasena-larga-y-unica"
admin_nombre = "Nombre del administrador"
admin_correo = "admin@nemet.mx"
# admin_forzar = true

# Clave con la que se firman las sesiones (recomendado definirla).
# Si se omite, la app genera una y la guarda en la base de usuarios.
# session_secret = "cadena-larga-y-aleatoria-de-al-menos-32-caracteres"

# Expiración de la sesión por inactividad, en minutos (por omisión 60).
# session_minutos = 60

# Ruta alternativa de la base de usuarios (por omisión ./nemet_usuarios.db).
# db = "nemet_usuarios.db"

# ------------------------------------------------------------
# [email]  Envío de cotizaciones por Gmail (opcional)
# ------------------------------------------------------------
[email]
remitente = "correo@gmail.com"
password = "contrasena-de-aplicacion"

# ------------------------------------------------------------
# [git]  Respaldo en GitHub del Excel y de la base de usuarios (opcional pero
#        muy recomendado en Streamlit Community Cloud, donde el disco es efímero)
# ------------------------------------------------------------
[git]
token = "github_pat_..."
repo = "nemet-source/nemet"
